---
import { routeOptions, whatsappLink } from "../data/site";

interface Props {
  area?: string;
  title?: string;
  note?: string;
  compact?: boolean;
}

const {
  area = "general",
  title = "Solicita información",
  note = "Comparte tus datos y un asesor te orientará sobre modalidad, fechas, precios o alternativas para tu equipo.",
  compact = false
} = Astro.props;
---

<section id="solicitud" class:list={["form-section", compact && "form-section--compact"]}>
  <div class="container-content">
    <div class="inquiry-shell">
      <div class="inquiry-header">
        <div class="inquiry-title-block">
          <p class="eyebrow">Contacto comercial</p>
          <h2>{title}</h2>
        </div>

        <div class="inquiry-meta">
          <p class="inquiry-note">{note}</p>
          <a
            class="whatsapp-button"
            href={whatsappLink}
            target="_blank"
            rel="noreferrer"
            data-analytics-event="whatsapp_click"
            data-analytics-label={`form_whatsapp_${area}`}
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Escríbenos por WhatsApp</span>
          </a>
        </div>
      </div>

      <form
        class="form-card form-card--integrated"
        name="solicitud-landing"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        data-route-form
      >
        <input type="hidden" name="form-name" value="solicitud-landing" />
        <input type="hidden" name="area" value={area} />
        <p hidden>
          <label>
            No llenar:
            <input name="bot-field" />
          </label>
        </p>

        <label class="field">
          <span>¿Qué necesitas?</span>
          <select name="tipo_solicitud" required data-route-select>
            {routeOptions.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </label>

        <div class="field-grid">
          <label class="field">
            <span>Nombre</span>
            <input type="text" name="nombre" autocomplete="name" required />
          </label>
          <label class="field" data-route="equipo medida">
            <span>Empresa</span>
            <input type="text" name="empresa" autocomplete="organization" />
          </label>
        </div>

        <div class="field-grid">
          <label class="field" data-route="equipo medida">
            <span>Cargo</span>
            <input type="text" name="cargo" />
          </label>
          <label
            class="field"
            data-route-label-equipo="Correo corporativo"
            data-route-label-medida="Correo corporativo"
            data-route-label-profesional="Correo"
          >
            <span>Correo corporativo</span>
            <input type="email" name="email" autocomplete="email" required />
          </label>
        </div>

        <div class="field-grid">
          <label class="field">
            <span>Teléfono</span>
            <input type="tel" name="telefono" autocomplete="tel" />
          </label>
          <label class="field" data-route="equipo">
            <span>Número de participantes</span>
            <input type="text" name="participantes" placeholder="Ej. 5, 12, 30" />
          </label>
        </div>

        <label class="field">
          <span>Necesidad principal</span>
          <textarea
            name="mensaje"
            rows="5"
            data-route-ph-equipo="Cuéntanos curso, número de personas, fechas y roles del equipo."
            data-route-ph-medida="Cuéntanos roles, alcance, brechas y resultado esperado."
            data-route-ph-profesional="Cuéntanos qué curso o área te interesa y tu disponibilidad."
            required
          ></textarea>
        </label>

        <button
          class="primary-button"
          type="submit"
          data-analytics-event="cta_click"
          data-analytics-label={`submit_${area}`}
          data-route-cta-equipo="Solicitar propuesta para mi equipo"
          data-route-cta-medida="Solicitar diseño del programa"
          data-route-cta-profesional="Solicitar información del curso"
        >
          Enviar solicitud
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll("[data-route-form]").forEach((form) => {
    const select = form.querySelector("[data-route-select]");
    if (!select) return;
    const apply = (value) => {
      form.querySelectorAll(".field[data-route]").forEach((field) => {
        const allowed = (field.getAttribute("data-route") || "").split(/\s+/);
        field.hidden = !allowed.includes(value);
      });
      form.querySelectorAll("[data-route-ph-equipo]").forEach((el) => {
        const ph = el.getAttribute(`data-route-ph-${value}`);
        if (ph) el.setAttribute("placeholder", ph);
      });
      form.querySelectorAll("[data-route-cta-equipo]").forEach((el) => {
        const label = el.getAttribute(`data-route-cta-${value}`);
        if (label) el.textContent = label;
      });
      form.querySelectorAll("[data-route-label-equipo]").forEach((el) => {
        const label = el.getAttribute(`data-route-label-${value}`);
        const span = el.querySelector("span");
        if (label && span) span.textContent = label;
      });
    };
    select.addEventListener("change", (e) => apply(e.target.value));
    apply(select.value);
  });
</script>
