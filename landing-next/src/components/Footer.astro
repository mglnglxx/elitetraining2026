---
import { contactLink, enterprisePhone, primaryPhone, sectors, whatsappLink } from "../data/site";

const sitemapServices = [
  { label: "HAZOP / LOPA", href: "https://hidrocarburos.com.co/producto/hazop-analisis-de-riesgos-y-operabilidad-presencial/" },
  { label: "Inspección RBI – API 580/581", href: "https://hidrocarburos.com.co/producto/inspeccion-basada-en-riesgo-rbi-acorde-con-api-580-581/" },
  { label: "API 579 – Fitness for Service", href: "https://hidrocarburos.com.co/producto/aptitud-para-el-servicio-fitness-for-services-api-579/" },
  { label: "Comisionamiento y Puesta en Marcha", href: "https://hidrocarburos.com.co/producto/gerencia-del-precomisionamiento-comisionamiento-y-puesta-en-marcha-de-proyectos-y-plantas-industriales/" },
  { label: "Protección Catódica", href: "https://campusvirtual.hidrocarburos.com.co/cursos/proteccion-catodica-galvanica-de-activos-enterrados/" },
  { label: "ISO 55001 – Gestión de Activos", href: "https://hidrocarburos.com.co/producto/programa-especialista-en-gestion-de-activos/" },
  { label: "RCM – Mantenimiento Centrado en Confiabilidad", href: "https://hidrocarburos.com.co/producto/mantenimiento-centrado-en-confiabilidad-rcm/" },
  { label: "NFPA 70E – Seguridad eléctrica", href: "https://hidrocarburos.com.co/producto/seguridad-electrica-en-lugares-de-trabajo-acorde-al-marco-legal-y-nfpa-70e/" },
  { label: "Tecnologías del Gas Natural", href: "https://campusvirtual.hidrocarburos.com.co/cursos/tecnologias-del-gas-natural/" },
  { label: "Análisis de fallas API 571", href: "https://hidrocarburos.com.co/producto/analisis-de-fallas-y-mecanismos-de-dano-en-la-industria-del-petroleo-y-gas-segun-api-571/" }
];
---

<footer class="site-footer">
  <div class="container-nav footer-grid">
    <div class="footer-brand">
      <img src="/assets/logos/elite-training.svg" alt="Elite Training" width="180" height="44" loading="lazy" />
      <p>
        Formación técnica industrial para equipos de operaciones críticas, mantenimiento, integridad, seguridad de
        procesos, gas natural y liderazgo técnico.
      </p>
      <div class="footer-social">
        <a href="https://www.linkedin.com/company/elite-training-hidrocarburos/" target="_blank" rel="noreferrer" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zm1.78 13.02H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>
        </a>
        <a href="https://www.youtube.com/@EliteTrainingHidrocarburos" target="_blank" rel="noreferrer" aria-label="YouTube">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.51 3.55 12 3.55 12 3.55s-7.51 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.87.5 9.38.5 9.38.5s7.51 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.81zM9.55 15.57V8.43L15.82 12l-6.27 3.57z"/></svg>
        </a>
        <a href="https://www.instagram.com/elitetraining.hidrocarburos/" target="_blank" rel="noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58 0 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s0 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58 0-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s0-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16M12 0C8.74 0 8.33 0 7.05.07c-1.28.06-2.15.26-2.91.55a5.86 5.86 0 0 0-2.13 1.38A5.86 5.86 0 0 0 .63 4.13c-.3.76-.5 1.63-.55 2.91C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.28.26 2.15.55 2.91.3.8.71 1.47 1.38 2.13.66.66 1.34 1.07 2.13 1.38.76.3 1.63.5 2.91.55C8.33 24 8.74 24 12 24s3.67-.01 4.95-.07c1.28-.06 2.15-.26 2.91-.55a5.86 5.86 0 0 0 2.13-1.38 5.86 5.86 0 0 0 1.38-2.13c.3-.76.5-1.63.55-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.28-.26-2.15-.55-2.91a5.86 5.86 0 0 0-1.38-2.13A5.86 5.86 0 0 0 19.86.63c-.76-.3-1.63-.5-2.91-.55C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z"/></svg>
        </a>
        <a href="https://www.facebook.com/EliteTrainingHidrocarburos" target="_blank" rel="noreferrer" aria-label="Facebook">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.69.24 2.69.24v2.97h-1.52c-1.49 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"/></svg>
        </a>
        <a href={`mailto:cursos@hidrocarburos.com.co`} aria-label="Email">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M22 4H2a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h20a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4l-10 6L2 8V6l10 6 10-6v2z"/></svg>
        </a>
      </div>
    </div>

    <div>
      <h3>Áreas de formación</h3>
      <ul>
        {sectors.map((sector) => (
          <li><a href={`/${sector.slug}`}>{sector.shortLabel}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3>Recursos</h3>
      <ul>
        <li><a href="https://hidrocarburos.com.co/shop" target="_blank" rel="noreferrer">Próximos cursos</a></li>
        <li><a href="https://campusvirtual.hidrocarburos.com.co" target="_blank" rel="noreferrer">Campus virtual</a></li>
        <li><a href="https://libreria.hidrocarburos.com.co/" target="_blank" rel="noreferrer">Libros técnicos</a></li>
        <li><a href="https://www.credly.com/organizations/elite-training/badges" target="_blank" rel="noreferrer">Insignias digitales</a></li>
        <li><a href="https://www.youtube.com/@EliteTrainingHidrocarburos" target="_blank" rel="noreferrer">Conferencias YouTube</a></li>
        <li><a href="https://hidrocarburos.com.co/calendario-2026" target="_blank" rel="noreferrer">Calendario 2026 (PDF)</a></li>
      </ul>
    </div>

    <div>
      <h3>Contacto</h3>
      <ul>
        <li><a href={contactLink} target="_blank" rel="noreferrer">Formulario de contacto</a></li>
        <li><a href={whatsappLink} target="_blank" rel="noreferrer">WhatsApp cursos abiertos</a></li>
        <li><span>{primaryPhone}</span></li>
        <li><span>{enterprisePhone}</span></li>
      </ul>
    </div>
  </div>

  <div class="container-nav footer-sitemap">
    <span class="footer-sitemap-label">Servicios:</span>
    {sitemapServices.map((s) => (
      <a href={s.href} target="_blank" rel="noreferrer">{s.label}</a>
    ))}
  </div>

  <div class="container-nav footer-bottom">
    <span>© Elite Training 2026 — 30 años de formación técnica industrial</span>
    <a href="https://hidrocarburos.com.co/politicas-para-el-tratamiento-de-datos-personales/" target="_blank" rel="noreferrer">
      Política de privacidad
    </a>
  </div>
</footer>
