---
import BaseLayout from "../layouts/BaseLayout.astro";
import ClientLogoGrid from "../components/ClientLogoGrid.astro";
import InquiryForm from "../components/InquiryForm.astro";
import Picture from "../components/Picture.astro";
import RouteCards from "../components/islands/RouteCards.svelte";
import { routeOptions, sectorCards } from "../data/site";

const featuredCourses = [
  {
    title: "Código ASME Secc VII – Calderas de Potencia",
    sector: "Integridad y Equipos",
    modality: "Online en vivo",
    nextDate: "5 mayo 2026",
    accent: "#95C11F",
    discount: "5%",
    priceOriginal: "US$775",
    priceFinal: "US$736",
    href: "https://hidrocarburos.com.co/producto/codigo-asme-secc-vii-guias-recomendadas-para-el-cuidado-de-calderas-de-potencia/"
  },
  {
    title: "Técnicas de Análisis de Causa Raíz",
    sector: "Seguridad y Riesgos",
    modality: "Online en vivo",
    nextDate: "19 mayo 2026",
    accent: "#2D3670",
    discount: "10%",
    priceOriginal: "US$550",
    priceFinal: "US$495",
    href: "https://hidrocarburos.com.co/producto/tecnicas-de-analisis-de-causa-raiz-y-eliminacion-de-causas-raices-de-riesgos/"
  },
  {
    title: "Medición de Gas Natural",
    sector: "Gas y Energía",
    modality: "Online en vivo",
    nextDate: "19 mayo 2026",
    accent: "#00A19A",
    discount: "10%",
    priceOriginal: "US$550",
    priceFinal: "US$495",
    href: "https://hidrocarburos.com.co/producto/medicion-de-gas-natural/"
  },
  {
    title: "Interpretación de Registros de Producción con Emeraude",
    sector: "Oil & Gas",
    modality: "Presencial · Bogotá",
    nextDate: "25 mayo 2026",
    accent: "#4F4F4F",
    discount: "10%",
    priceOriginal: "US$4.400",
    priceFinal: "US$3.960",
    href: "https://hidrocarburos.com.co/producto/interpretacion-de-registros-de-produccion-con-emeraude/"
  }
];

const masterClasses = [
  {
    title: "¿Por qué seguimos teniendo los mismos accidentes?",
    subtitle: "Una mirada técnica a las fallas reales en la gestión de riesgos mayores y PSM en Latinoamérica.",
    framing: "Semana Mundial de la Seguridad y Salud en el Trabajo",
    speaker: "Cesar Puma",
    speakerRole: "Experto en gestión de riesgos mayores y PSM en Latinoamérica",
    speakerPhoto: "/assets/img/cesar-puma.png",
    date: "2026-04-30T16:00:00-05:00",
    dateLabel: "Jueves 30 abril · 4:00 pm Bogotá / Lima · 5:00 pm Argentina",
    duration: "60 min",
    register: "https://us06web.zoom.us/meeting/register/ao9mQ2HVQMa7ty1JUskZzw"
  }
];

const coursesLd = featuredCourses.map((c) => ({
  "@context": "https://schema.org",
  "@type": "Course",
  name: c.title,
  description: `Curso ${c.sector} — ${c.modality}. Próxima fecha: ${c.nextDate}.`,
  url: c.href,
  provider: {
    "@type": "EducationalOrganization",
    name: "Elite Training",
    url: "https://landing.hidrocarburos.com.co"
  },
  hasCourseInstance: {
    "@type": "CourseInstance",
    courseMode: c.modality.toLowerCase().includes("presencial") ? "onsite" : "online",
    startDate: c.nextDate
  },
  offers: {
    "@type": "Offer",
    price: c.priceFinal.replace(/[^0-9.]/g, ""),
    priceCurrency: "USD",
    url: c.href,
    availability: "https://schema.org/InStock"
  }
}));

const responsiveWebp = (src: string, originalWidth: number, widths = [480, 768, 1024]) => [
  ...widths
    .filter((width) => width < originalWidth)
    .map((width) => `${src.replace(/\.(jpe?g|png)$/i, `-${width}.webp`)} ${width}w`),
  `${src.replace(/\.(jpe?g|png)$/i, ".webp")} ${originalWidth}w`
].join(", ");
---

<BaseLayout
  title="Elite Training | Formación técnica industrial para empresas y profesionales"
  description="Programas, cursos y rutas de capacitación técnica para operaciones críticas, mantenimiento, integridad, gas natural y seguridad de procesos."
  preloadImage="/assets/img/hero-team.jpg"
>
  {coursesLd.map((ld) => (
    <script type="application/ld+json" set:html={JSON.stringify(ld)}></script>
  ))}
  <section class="hero-home">
    <div class="container-nav hero-home-grid">
      <div class="hero-home-copy">
        <p class="eyebrow">Formación técnica industrial</p>
        <h1>Formación técnica industrial para equipos y profesionales.</h1>
        <p class="lead">
          Cursos abiertos, in-company y virtuales. La ruta correcta según tu necesidad — 30 años formando equipos en Oil &amp; Gas, energía y manufactura en Latinoamérica.
        </p>
        <div class="hero-home-actions">
          <a class="primary-button" href="#solicitud" data-analytics-event="cta_click" data-analytics-label="home_solicitar">
            Solicitar información
          </a>
          <a class="secondary-button" href="#areas" data-analytics-event="cta_click" data-analytics-label="home_areas">
            Explorar áreas
          </a>
        </div>
      </div>

      <div class="hero-home-panel">
        <figure class="hero-image" data-hero-carousel>
          <div class="hero-image-stack">
            {[
              { src: "/assets/img/hero-team.jpg", alt: "Equipo técnico industrial en formación", w: 1200, h: 800, label: "Formación técnica industrial", active: true, eager: true },
              { src: "/assets/img/sector-oil-gas.jpg", alt: "Operaciones Oil & Gas", w: 1280, h: 853, label: "Oil & Gas · producción y pozos" },
              { src: "/assets/img/sector-seguridad.jpg", alt: "Seguridad de procesos", w: 1280, h: 853, label: "Seguridad de procesos · PSM" },
              { src: "/assets/img/sector-integridad.jpg", alt: "Integridad y equipos", w: 1280, h: 853, label: "Integridad de equipos · API" },
              { src: "/assets/img/sector-mantenimiento.jpg", alt: "Mantenimiento y confiabilidad", w: 1280, h: 853, label: "Activos y mantenimiento" },
              { src: "/assets/img/sector-gas.jpg", alt: "Gas natural y energía", w: 1280, h: 853, label: "Gas natural · GLP · energía" },
              { src: "/assets/img/sector-habilidades.jpg", alt: "Habilidades directivas técnicas", w: 1280, h: 853, label: "Habilidades directivas técnicas" }
            ].map((s) => (
              <picture>
                <source
                  type="image/webp"
                  srcset={responsiveWebp(s.src, s.w)}
                  sizes="(min-width: 1100px) 42vw, 100vw"
                />
                <img
                  src={s.src}
                  alt={s.alt}
                  width={s.w}
                  height={s.h}
                  loading={s.eager ? "eager" : "lazy"}
                  fetchpriority={s.eager ? "high" : undefined}
                  decoding="async"
                  data-hero-slide
                  data-label={s.label}
                  class={s.active ? "is-active" : undefined}
                />
              </picture>
            ))}
          </div>
          <figcaption class="hero-image-tag">
            <span class="hero-image-dot"></span>
            <span data-hero-label>Formación técnica industrial</span>
          </figcaption>
        </figure>
      </div>
      <script>
        (() => {
          const carousel = document.querySelector("[data-hero-carousel]");
          if (!carousel) return;
          const slides = Array.from(carousel.querySelectorAll("[data-hero-slide]"));
          const label = carousel.querySelector("[data-hero-label]");
          if (slides.length < 2) return;
          let i = 0;
          let timer = null;
          const swap = () => {
            const next = (i + 1) % slides.length;
            slides[i].classList.remove("is-active");
            slides[next].classList.add("is-active");
            if (label) {
              label.style.opacity = "0";
              setTimeout(() => {
                label.textContent = slides[next].dataset.label || "";
                label.style.opacity = "1";
              }, 400);
            }
            i = next;
          };
          const start = () => { if (!timer) timer = setInterval(swap, 5000); };
          const stop = () => { if (timer) { clearInterval(timer); timer = null; } };
          start();
          document.addEventListener("visibilitychange", () => {
            document.hidden ? stop() : start();
          });
        })();
      </script>
    </div>
    <div class="container-nav hero-stat-shell">
      <div class="hero-stat-band">
        <div class="hero-stat-item">
          <span>30 años</span>
          <em>de formación técnica industrial</em>
        </div>
        <div class="hero-stat-item">
          <span>11+ países</span>
          <em>en Latinoamérica</em>
        </div>
        <div class="hero-stat-item">
          <span>200+ empresas</span>
          <em>industriales y energéticas</em>
        </div>
        <div class="hero-stat-item">
          <span>2.600+</span>
          <em>insignias Credly emitidas</em>
        </div>
      </div>
    </div>
  </section>

  <section id="rutas" class="section-block section-block--white fade-in">
    <div class="container-content section-header">
      <div>
        <p class="eyebrow">Rutas de atención</p>
        <h2>Elige la ruta más cercana a tu necesidad y nuestro equipo te ayuda a aterrizarla.</h2>
      </div>
      <p class="section-intro">
        Cada conversación arranca distinto según quién pregunte y qué necesite resolver. Estas cuatro rutas
        nos ayudan a ubicarte rápido y orientarte sobre fechas, modalidad, propuesta y siguiente paso.
      </p>
    </div>
    <div class="container-content">
      <RouteCards routes={routeOptions} client:visible />
    </div>
  </section>

  <section id="areas" class="section-block fade-in">
    <div class="container-content section-header">
      <div>
        <p class="eyebrow">Áreas de formación</p>
        <h2>Seis áreas para equipos técnicos, líderes industriales y profesionales que necesitan criterio aplicado.</h2>
      </div>
      <p class="section-intro">
        Cada frente agrupa cursos, programas y temas frecuentes para que la conversación comercial comience desde una
        necesidad técnica real, no desde un catálogo genérico.
      </p>
    </div>
    <div class="container-content">
      <div class="sector-grid">
        {sectorCards.map((sector) => (
          <a
            class="sector-card"
            href={`/${sector.slug}`}
            style={`--sector-accent:${sector.accent}; --sector-soft:${sector.accentSoft};`}
            data-analytics-event="cta_click"
            data-analytics-label={`sector_${sector.slug}`}
