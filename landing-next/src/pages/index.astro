              <Picture src={sector.badge} alt={`Insignia ${sector.shortLabel}`} width={400} height={400} />
            </div>
            <div class="sector-card-content">
              <span class="sector-card-tag">{sector.shortLabel}</span>
              <h3>{sector.menuLabel}</h3>
              <p>{sector.overview}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-block section-block--white fade-in">
    <div class="container-content section-header">
      <div>
        <p class="eyebrow">Próximos cursos abiertos</p>
        <h2>Cursos destacados con fechas próximas. Inscripción individual o por equipos.</h2>
      </div>
      <p class="section-intro">
        Una muestra de los cursos más solicitados. El catálogo completo, precios y carrito están en la tienda
        Hidrocarburos.
      </p>
    </div>
    <div class="container-content">
      <div class="featured-grid">
        {featuredCourses.map((course) => (
          <a
            class="featured-card"
            href={course.href}
            target="_blank"
            rel="noreferrer"
            style={`--course-accent:${course.accent};`}
            data-analytics-event="cta_click"
            data-analytics-label={`featured_course_${course.title}`}
          >
            <div class="featured-card-head">
              <span class="featured-card-sector">{course.sector}</span>
              <span class="featured-card-modality">{course.modality}</span>
            </div>
            <h3>{course.title}</h3>
            <div class="featured-card-meta">
              <div>
                <span>Próxima fecha</span>
                <strong>{course.nextDate}</strong>
              </div>
              <div class="featured-card-price">
                <span class="featured-card-discount">{course.discount} OFF</span>
                <strong>
                  <s>{course.priceOriginal}</s> {course.priceFinal} <em>+IVA</em>
                </strong>
              </div>
            </div>
            <span class="featured-card-cta">Ver en tienda →</span>
          </a>
        ))}
      </div>
      <div class="featured-cta-row">
        <a
          class="primary-button"
          href="https://hidrocarburos.com.co/shop"
          target="_blank"
          rel="noreferrer"
          data-analytics-event="cta_click"
          data-analytics-label="ver_catalogo_completo"
        >
          Ver catálogo completo en tienda
        </a>
      </div>
    </div>
  </section>

  <section id="campus" class="section-block fade-in">
    <div class="container-content">
      <div class="campus-shell">
        <div class="campus-copy">
          <p class="eyebrow eyebrow--light">Campus virtual</p>
