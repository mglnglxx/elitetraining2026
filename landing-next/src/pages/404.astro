---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sectors } from "../data/site";
---

<BaseLayout
  title="Página no encontrada | Elite Training"
  description="La página que buscas ya no existe o se movió. Explora las áreas de formación o vuelve al inicio."
>
  <section class="section-block" style="padding: 80px 0 100px;">
    <div class="container-content" style="text-align: center; max-width: 720px;">
      <p class="eyebrow">Error 404</p>
      <h1 style="margin: 16px 0 12px;">Esta página no existe.</h1>
      <p class="lead" style="margin-bottom: 32px;">
        Puede que el enlace haya cambiado o que el contenido ya no esté disponible.
        Desde aquí puedes volver al inicio o explorar un área de formación.
      </p>
      <div class="hero-actions" style="justify-content: center; margin-bottom: 48px;">
        <a class="primary-button" href="/">Volver al inicio</a>
        <a class="secondary-button" href="/#areas">Ver áreas de formación</a>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; text-align: left;">
        {sectors.map((sector) => (
          <a href={`/${sector.slug}`} class="route-card" style="padding: 16px 18px;">
            <strong style="display:block;">{sector.shortLabel}</strong>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
